      <artifactId>pdfbox</artifactId>
      <version>3.0.8</version>
    </dependency>
    <!-- OpenHTMLtoPDF release built on PDFBox 3.0.8, kept aligned with the pdfbox dependency above. -->
    <dependency>
      <groupId>io.github.openhtmltopdf</groupId>
      <artifactId>openhtmltopdf-pdfbox</artifactId>
      <version>1.1.110</version>
    </dependency>
    <!-- Logic-less templates uploaded by tenants for the inventory loan sheet; version managed by Spring Boot. -->
    <dependency>
      <groupId>com.samskivert</groupId>
